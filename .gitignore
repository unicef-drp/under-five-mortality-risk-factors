# Survey microdata: DHS/MICS/IPUMS terms do not allow redistribution, and the files
# are far over GitHub's size limits. Download the extracts into input/ipums/ and
# rebuild with code/fertility_risk_factors_from_ipums.R.
input/ipums/
input/fertility/dhs database.csv
input/fertility/mics database.csv

# DHS API download for Figure 26: redownload rather than redistribute (see README)
input/stillbirth/

# Pipeline outputs, regenerated by code/01-07. The number-check report is source.
output/*
!output/An_Uneven_Chance_of_Survival_full_report_number_checked_final.qmd

# Generated figures: the PNGs are tracked, the vector PDFs run to tens of MB each
figures/*.pdf
figures/**/*.pdf

# Cached source downloads for the subnational build (Eurostat, GADM, country files)
Subnational/input/

# Rebuilt by Subnational/R; mostly redistributed Eurostat tables
Subnational/output/subnational database_eurostat.xlsx

# UN IGME publication, available at childmortality.org
Subnational/UN-IGME-2023-Subnational-U5MR-and-NMR-database-survey.xlsx

# Not part of the analysis
design/
website/
docs/
code/method and number in the text/

